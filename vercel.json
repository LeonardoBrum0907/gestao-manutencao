{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm --filter @manutencao/shared build && pnpm --filter @manutencao/web build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cage-qualify-right-ages.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://cage-qualify-right-ages.trycloudflare.com/health"
    },
    {
      "source": "/:route(mcp|authorize|token|register|revoke)",
      "destination": "https://cage-qualify-right-ages.trycloudflare.com/:route"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://cage-qualify-right-ages.trycloudflare.com/.well-known/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
