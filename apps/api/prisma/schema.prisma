generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Factory {
  id        String    @id @default(cuid())
  name      String
  machines  Machine[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Machine {
  id           String          @id @default(cuid())
  name         String
  factoryId    String
  factory      Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  sector       String?
  manufacturer String?
  internalCode String?
  status       String
  notes        String?
  isDailyLine  Boolean         @default(false)
  isCritical   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberLinks  MemberMachine[]

  @@index([factoryId])
}

model MemberRole {
  id      String   @id @default(cuid())
  name    String   @unique
  members Member[]
}

model MemberGrade {
  id       String   @id @default(cuid())
  name     String   @unique
  position Int
  members  Member[]
}

model Team {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  supervisorId String?
  supervisor   Member?  @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  members      Member[] @relation("TeamMembers")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supervisorId])
}

model Member {
  id           String       @id @default(cuid())
  name         String
  position     String       @default("technician")
  teamId       String?
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)
  roleId       String?
  role         MemberRole?  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  gradeId      String?
  grade        MemberGrade? @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  shift        String
  area         String?
  status       String
  registration String?
  contact      String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  matrixEquipments MemberMatrixEquipment[]
  skills           MemberSkill[]
  records          Record[]
  recordLinks      RecordMember[]
  supervisedTeams  Team[]                  @relation("TeamSupervisor")
  behavior         MemberBehavior?
  evaluations      MemberEvaluation[]
  machines         MemberMachine[]
  pdiAttachments   MemberAttachment[]

  @@index([roleId])
  @@index([gradeId])
  @@index([teamId])
}

model MemberBehavior {
  memberId      String   @id
  punctuality   String?
  productivity  String?
  collaboration String?
  tags          String[]
  updatedAt     DateTime @updatedAt
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberEvaluation {
  memberId   String
  year       Int
  quarter    Int
  competency String
  score      Int
  updatedAt  DateTime @updatedAt
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, year, quarter, competency])
}

// Máquinas do PDI: "sponsor" (padrinho, responsável) ou "development" (aprendendo).
model MemberMachine {
  memberId  String
  machineId String
  kind      String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([memberId, machineId, kind])
  @@index([machineId])
}

// Arquivos do PDI. Restrict: excluir o colaborador apagaria a linha e deixaria o arquivo no disco.
model MemberAttachment {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([memberId])
}

model MemberMatrixEquipment {
  memberId  String
  equipment String
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, equipment])
}

model MemberSkill {
  memberId      String
  skillId       String
  score         Int?
  notApplicable Boolean  @default(false)
  expected      Int?
  updatedAt     DateTime @updatedAt
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, skillId])
}

model Record {
  id           String             @id @default(cuid())
  type         String
  body         String
  occurredAt   DateTime
  status       String
  memberId     String?
  member       Member?            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  factoryId    String?
  machineId    String?
  machineLabel String?
  tag          String?
  line         String?
  priority     String?
  tone         String?
  dueAt        DateTime?
  notes        String?
  origin       String
  dayNumber    Int?
  openedAt     DateTime?
  closedAt     DateTime?
  durationMin  Int?
  members      RecordMember[]
  attachments  RecordAttachment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([type, status])
  @@index([dueAt])
  @@index([origin])
  @@index([memberId])
}

model RecordMember {
  recordId String
  memberId String
  position Int
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([recordId, memberId])
  @@index([memberId])
}

model RecordAttachment {
  id         String   @id @default(cuid())
  recordId   String
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([recordId])
}
