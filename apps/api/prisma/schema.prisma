generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Factory {
  id        String    @id @default(cuid())
  name      String
  machines  Machine[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Machine {
  id           String          @id @default(cuid())
  name         String
  factoryId    String
  factory      Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  sector       String?
  manufacturer String?
  internalCode String?
  status       String
  notes        String?
  isDailyLine  Boolean         @default(false)
  isCritical   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberLinks  MemberMachine[]
  pdiItems     MemberPdiItem[]

  @@index([factoryId])
}

model MemberRole {
  id      String   @id @default(cuid())
  name    String   @unique
  members Member[]
}

model MemberGrade {
  id       String   @id @default(cuid())
  name     String   @unique
  position Int
  members  Member[]
}

model Team {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  supervisorId String?
  supervisor   Member?  @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  members      Member[] @relation("TeamMembers")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supervisorId])
}

model Member {
  id           String       @id @default(cuid())
  name         String
  position     String       @default("technician")
  teamId       String?
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)
  roleId       String?
  role         MemberRole?  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  gradeId      String?
  grade        MemberGrade? @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  shift        String
  area         String?
  status       String
  registration String?
  contact      String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  matrixEquipments MemberMatrixEquipment[]
  skills           MemberSkill[]
  records          Record[]
  recordLinks      RecordMember[]
  supervisedTeams  Team[]                  @relation("TeamSupervisor")
  behavior         MemberBehavior?
  evaluations      MemberEvaluation[]
  machines         MemberMachine[]
  pdiAttachments   MemberAttachment[]
  pdiItems         MemberPdiItem[]         @relation("PdiItemMember")
  pdiResponsible   MemberPdiItem[]         @relation("PdiItemResponsible")

  @@index([roleId])
  @@index([gradeId])
  @@index([teamId])
}

model MemberBehavior {
  memberId      String   @id
  punctuality   String?
  productivity  String?
  collaboration String?
  tags          String[]
  updatedAt     DateTime @updatedAt
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// Competências da avaliação de desempenho: cadastro do coordenador. Arquivada sai da avaliação, mas a nota antiga fica.
model PerformanceCompetency {
  id          String             @id @default(cuid())
  name        String             @unique
  position    Int
  archived    Boolean            @default(false)
  evaluations MemberEvaluation[]
}

model MemberEvaluation {
  memberId     String
  year         Int
  quarter      Int
  competencyId String
  score        Int
  updatedAt    DateTime              @updatedAt
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  competency   PerformanceCompetency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@id([memberId, year, quarter, competencyId])
  @@index([competencyId])
}

// Máquinas do PDI: "sponsor" (padrinho, responsável) ou "development" (aprendendo).
model MemberMachine {
  memberId  String
  machineId String
  kind      String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([memberId, machineId, kind])
  @@index([machineId])
}

// Arquivos do PDI. Restrict: excluir o colaborador apagaria a linha e deixaria o arquivo no disco.
model MemberAttachment {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([memberId])
}

// Itens do PDI formal: ação para fechar uma lacuna (habilidade da matriz e/ou máquina), com prazo, responsável e status.
// Habilidade, máquina e responsável são opcionais e viram nulos se forem excluídos.
model MemberPdiItem {
  id            String       @id @default(cuid())
  memberId      String
  member        Member       @relation("PdiItemMember", fields: [memberId], references: [id], onDelete: Cascade)
  title         String
  skillId       String?
  skill         MatrixSkill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  machineId     String?
  machine       Machine?     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  responsibleId String?
  responsible   Member?      @relation("PdiItemResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  dueDate       DateTime?    @db.Date
  status        String       @default("planned")
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([memberId])
  @@index([skillId])
  @@index([machineId])
  @@index([responsibleId])
}

// Catálogo da matriz de habilidades: cadastro do coordenador (os 9 equipamentos e as 222 habilidades do SIGEM de partida).
// Arquivado sai da matriz, mas o que já foi marcado ou avaliado fica guardado.
model MatrixEquipment {
  id           String                  @id @default(cuid())
  name         String                  @unique
  position     Int
  archived     Boolean                 @default(false)
  // Quantos técnicos qualificados o equipamento precisa ter; 0 = sem mínimo.
  minQualified Int                     @default(0)
  skills       MatrixSkill[]
  members      MemberMatrixEquipment[]
}

model MatrixSkill {
  id          String          @id @default(cuid())
  equipmentId String
  equipment   MatrixEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  subgroup    String
  text        String
  level       String
  position    Int
  archived    Boolean         @default(false)
  scores      MemberSkill[]
  pdiItems    MemberPdiItem[]

  @@index([equipmentId])
}

model MemberMatrixEquipment {
  memberId    String
  equipmentId String
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  equipment   MatrixEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([memberId, equipmentId])
  @@index([equipmentId])
}

model MemberSkill {
  memberId      String
  skillId       String
  score         Int?
  notApplicable Boolean     @default(false)
  expected      Int?
  updatedAt     DateTime    @updatedAt
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill         MatrixSkill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([memberId, skillId])
  @@index([skillId])
}

model Record {
  id           String             @id @default(cuid())
  type         String
  body         String
  occurredAt   DateTime
  status       String
  memberId     String?
  member       Member?            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  factoryId    String?
  machineId    String?
  machineLabel String?
  tag          String?
  line         String?
  priority     String?
  tone         String?
  dueAt        DateTime?
  notes        String?
  origin       String
  dayNumber    Int?
  openedAt     DateTime?
  closedAt     DateTime?
  durationMin  Int?
  members      RecordMember[]
  attachments  RecordAttachment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([type, status, dueAt])
  @@index([origin])
  @@index([memberId])
  @@index([machineId])
  @@index([occurredAt, id])
  @@index([createdAt])
}

model RecordMember {
  recordId String
  memberId String
  position Int
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([recordId, memberId])
  @@index([memberId])
}

model RecordAttachment {
  id         String   @id @default(cuid())
  recordId   String
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([recordId])
}
