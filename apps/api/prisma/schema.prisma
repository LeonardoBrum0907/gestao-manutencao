generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Factory {
  id        String   @id @default(cuid())
  name      String
  lines     Line[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Linha de produção (CAM 08, MED 02). Até a migração de 2026-10-07 se chamava Machine.
model Line {
  id           String          @id @default(cuid())
  name         String
  factoryId    String
  factory      Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  sector       String?
  manufacturer String?
  // TAG da linha (ex.: EBS-BLI-31). Fica na linha até se saber se é de um equipamento.
  internalCode String?
  status       String
  notes        String?
  isDailyLine  Boolean         @default(false)
  isCritical   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  machines     Machine[]
  memberLinks  MemberLine[]
  pdiItems     MemberPdiItem[]

  @@index([factoryId])
}

// Máquina (equipamento) de uma linha: a Encartuchadeira da CAM 05. O modelo é o equipamento do catálogo da matriz.
model Machine {
  id              String           @id @default(cuid())
  lineId          String
  line            Line             @relation(fields: [lineId], references: [id], onDelete: Restrict)
  equipmentId     String?
  equipment       MatrixEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  name            String
  tag             String?
  manufacturer    String?
  status          String
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  postPreventives PostPreventive[]
  chamados        Record[]

  @@index([lineId])
  @@index([equipmentId])
}

// Subconjunto de um modelo de equipamento (Válvulas roletes da Encartuchadeira CAM). Vale para todas as máquinas do modelo.
// Arquivado sai das listas de escolha, mas o que já aponta para ele fica.
model Subassembly {
  id              String           @id @default(cuid())
  equipmentId     String
  equipment       MatrixEquipment  @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  name            String
  position        Int
  archived        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  postPreventives PostPreventive[]

  @@unique([equipmentId, name])
}

model MemberRole {
  id      String   @id @default(cuid())
  name    String   @unique
  members Member[]
}

model MemberGrade {
  id       String   @id @default(cuid())
  name     String   @unique
  position Int
  members  Member[]
}

model Team {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  supervisorId String?
  supervisor   Member?  @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  members      Member[] @relation("TeamMembers")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supervisorId])
}

model Member {
  id           String       @id @default(cuid())
  name         String
  position     String       @default("technician")
  teamId       String?
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)
  roleId       String?
  role         MemberRole?  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  gradeId      String?
  grade        MemberGrade? @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  shift        String
  area         String?
  status       String
  registration String?
  contact      String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  matrixEquipments    MemberMatrixEquipment[]
  skills              MemberSkill[]
  records             Record[]
  recordLinks         RecordMember[]
  rpLinks             RpMember[]
  postPreventiveLinks PostPreventiveMember[]
  supervisedTeams     Team[]                  @relation("TeamSupervisor")
  behavior            MemberBehavior?
  evaluations         MemberEvaluation[]
  lines               MemberLine[]
  pdiAttachments      MemberAttachment[]
  pdiItems            MemberPdiItem[]         @relation("PdiItemMember")
  pdiResponsible      MemberPdiItem[]         @relation("PdiItemResponsible")

  @@index([roleId])
  @@index([gradeId])
  @@index([teamId])
}

model MemberBehavior {
  memberId      String   @id
  punctuality   String?
  productivity  String?
  collaboration String?
  tags          String[]
  updatedAt     DateTime @updatedAt
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// Competências da avaliação de desempenho: cadastro do coordenador. Arquivada sai da avaliação, mas a nota antiga fica.
model PerformanceCompetency {
  id          String             @id @default(cuid())
  name        String             @unique
  position    Int
  archived    Boolean            @default(false)
  evaluations MemberEvaluation[]
  pdiItems    MemberPdiItem[]
}

model MemberEvaluation {
  memberId     String
  year         Int
  quarter      Int
  competencyId String
  score        Int
  updatedAt    DateTime              @updatedAt
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  competency   PerformanceCompetency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@id([memberId, year, quarter, competencyId])
  @@index([competencyId])
}

// Linhas do PDI: "sponsor" (padrinho, responsável) ou "development" (aprendendo).
model MemberLine {
  memberId String
  lineId   String
  kind     String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  line     Line   @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@id([memberId, lineId, kind])
  @@index([lineId])
}

// Arquivos do PDI. Restrict: excluir o colaborador apagaria a linha e deixaria o arquivo no disco.
model MemberAttachment {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([memberId])
}

// Itens do PDI formal: ação para fechar uma lacuna (habilidade da matriz, competência da avaliação e/ou linha), com prazo, responsável e status.
// Habilidade, competência, linha e responsável são opcionais e viram nulos se forem excluídos.
model MemberPdiItem {
  id            String       @id @default(cuid())
  memberId      String
  member        Member       @relation("PdiItemMember", fields: [memberId], references: [id], onDelete: Cascade)
  title         String
  skillId       String?
  skill         MatrixSkill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  competencyId  String?
  competency    PerformanceCompetency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  lineId        String?
  line          Line?        @relation(fields: [lineId], references: [id], onDelete: SetNull)
  responsibleId String?
  responsible   Member?      @relation("PdiItemResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  dueDate       DateTime?    @db.Date
  status        String       @default("planned")
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([memberId])
  @@index([skillId])
  @@index([competencyId])
  @@index([lineId])
  @@index([responsibleId])
}

// Ajustes de matriz e desempenho (uma linha só, id "default"): aderência mínima para contar como qualificado e meta das notas do gráfico de desempenho.
model MatrixSetting {
  id                 String @id @default("default")
  qualifiedAdherence Int    @default(80)
  performanceTarget  Int    @default(8)
}

// Catálogo da matriz de habilidades: cadastro do coordenador (os 9 equipamentos e as 222 habilidades do SIGEM de partida).
// Arquivado sai da matriz, mas o que já foi marcado ou avaliado fica guardado.
model MatrixEquipment {
  id            String                  @id @default(cuid())
  name          String                  @unique
  position      Int
  archived      Boolean                 @default(false)
  // Quantos técnicos qualificados o equipamento precisa ter; 0 = sem mínimo.
  minQualified  Int                     @default(0)
  skills        MatrixSkill[]
  members       MemberMatrixEquipment[]
  machines      Machine[]
  subassemblies Subassembly[]
}

model MatrixSkill {
  id          String          @id @default(cuid())
  equipmentId String
  equipment   MatrixEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  subgroup    String
  text        String
  level       String
  position    Int
  archived    Boolean         @default(false)
  scores      MemberSkill[]
  pdiItems    MemberPdiItem[]

  @@index([equipmentId])
}

model MemberMatrixEquipment {
  memberId    String
  equipmentId String
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  equipment   MatrixEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([memberId, equipmentId])
  @@index([equipmentId])
}

model MemberSkill {
  memberId      String
  skillId       String
  score         Int?
  notApplicable Boolean     @default(false)
  expected      Int?
  updatedAt     DateTime    @updatedAt
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill         MatrixSkill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([memberId, skillId])
  @@index([skillId])
}

model Record {
  id          String             @id @default(cuid())
  type        String
  body        String
  occurredAt  DateTime
  status      String
  memberId    String?
  member      Member?            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  factoryId   String?
  lineId      String?
  lineLabel   String?
  tag         String?
  line        String?
  priority    String?
  tone        String?
  dueAt       DateTime?
  notes       String?
  origin      String
  dayNumber   Int?
  openedAt    DateTime?
  closedAt    DateTime?
  durationMin Int?
  // Chamado: turno (first, second, third) e máquina da linha, se souber.
  shift       String?
  machineId   String?
  machine     Machine?           @relation(fields: [machineId], references: [id], onDelete: SetNull)
  // Tarefa gerada a partir de um chamado ("gerar pendência").
  chamadoId   String?
  chamado     Record?            @relation("ChamadoTasks", fields: [chamadoId], references: [id], onDelete: SetNull)
  tasks       Record[]           @relation("ChamadoTasks")
  members     RecordMember[]
  attachments RecordAttachment[]
  rp          Rp?                @relation("RpMirror")
  // RP escrito a partir deste chamado.
  rpOfChamado Rp?                @relation("RpChamado")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([type, status, dueAt])
  @@index([origin])
  @@index([memberId])
  @@index([lineId])
  @@index([occurredAt, id])
  @@index([createdAt])
  @@index([machineId])
  @@index([chamadoId])
}

model RecordMember {
  recordId String
  memberId String
  position Int
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([recordId, memberId])
  @@index([memberId])
}

model RecordAttachment {
  id         String   @id @default(cuid())
  recordId   String
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([recordId])
}

// RP (Relatório Padrão de Manutenção): ficha própria, com um Problema de origem "rp" como espelho nas listas.
model Rp {
  id                   String           @id @default(cuid())
  occurredAt           DateTime
  orderNumber          String?
  orderKey             String?
  factoryId            String
  lineId               String?
  line                 String?
  tag                  String?
  problem              String
  problemKey           String
  description          String?
  repeatedFailure      Boolean          @default(false)
  repeatedTimes        String?
  repeatedPeriod       String?
  causeMaterial        Boolean          @default(false)
  materialText         String?
  causeMachine         Boolean          @default(false)
  machineText          String?
  causeMethod          Boolean          @default(false)
  methodText           String?
  causeLabor           Boolean          @default(false)
  laborText            String?
  rootCause            String?
  corrective           String?
  preventive           String?
  status               String
  basicConditionImpact String?
  unmatchedTechnicians String?
  rawText              String
  problemRecordId      String?          @unique
  problemRecord        Record?          @relation("RpMirror", fields: [problemRecordId], references: [id], onDelete: SetNull)
  chamadoId            String?          @unique
  chamado              Record?          @relation("RpChamado", fields: [chamadoId], references: [id], onDelete: SetNull)
  members              RpMember[]
  postPreventives      PostPreventive[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([occurredAt, id])
  @@index([lineId])
  @@index([status])
  @@index([orderKey])
  @@index([tag])
}

model RpMember {
  rpId     String
  memberId String
  position Int
  rp       Rp     @relation(fields: [rpId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([rpId, memberId])
  @@index([memberId])
}

// Pós-preventiva: ocorrência que apareceu depois de uma preventiva, com a ação para não repetir
// e o ponto de atenção que vai para a folha do técnico na próxima preventiva da máquina.
model PostPreventive {
  id               String                 @id @default(cuid())
  preventiveDate   DateTime               @db.Date
  occurrenceDate   DateTime?              @db.Date
  machineId        String
  machine          Machine                @relation(fields: [machineId], references: [id], onDelete: Restrict)
  subassemblyId    String
  subassembly      Subassembly            @relation(fields: [subassemblyId], references: [id], onDelete: Restrict)
  done             String
  occurrence       String
  preventiveAction String
  attentionPoint   String
  // Desligado: o ponto sai da folha do técnico, mas a ficha continua no histórico.
  attentionActive  Boolean                @default(true)
  rpId             String?
  rp               Rp?                    @relation(fields: [rpId], references: [id], onDelete: SetNull)
  members          PostPreventiveMember[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([preventiveDate, id])
  @@index([machineId])
  @@index([subassemblyId])
  @@index([rpId])
}

model PostPreventiveMember {
  postPreventiveId String
  memberId         String
  position         Int
  postPreventive   PostPreventive @relation(fields: [postPreventiveId], references: [id], onDelete: Cascade)
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([postPreventiveId, memberId])
  @@index([memberId])
}
