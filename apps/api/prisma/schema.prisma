generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Cliente OAuth que se registrou sozinho para usar o MCP (o conector do claude.ai, por exemplo).
// O registro inteiro fica em data, no formato do protocolo.
model McpClient {
  id        String     @id
  data      Json
  tokens    McpToken[]
  createdAt DateTime   @default(now())
}

// Chave de acesso ou de renovação entregue a um cliente MCP. Só o hash fica gravado.
model McpToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  kind      String
  clientId  String
  client    McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes    String[]
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([expiresAt])
}

model Factory {
  id        String   @id @default(cuid())
  name      String
  lines     Line[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Linha de produção (CAM 08, MED 02). Até a migração de 2026-10-07 se chamava Machine.
model Line {
  id           String          @id @default(cuid())
  name         String
  factoryId    String
  factory      Factory         @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  sector       String?
  manufacturer String?
  // TAG da linha (ex.: EBS-BLI-31). Fica na linha até se saber se é de um equipamento.
  internalCode String?
  status       String
  notes        String?
  isDailyLine  Boolean         @default(false)
  isCritical   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  machines     Machine[]
  memberLinks  MemberLine[]
  pdiItems     MemberPdiItem[]
  techCards    TechCard[]

  @@index([factoryId])
}

// Máquina (equipamento) de uma linha: a Encartuchadeira da CAM 05. O modelo é o equipamento do catálogo da matriz
// (ex.: Blistadeira M91); duas versões da mesma máquina são dois modelos.
model Machine {
  id                  String                     @id @default(cuid())
  lineId              String
  line                Line                       @relation(fields: [lineId], references: [id], onDelete: Restrict)
  equipmentId         String?
  equipment           MatrixEquipment?           @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  name                String
  tag                 String?
  manufacturer        String?
  status              String
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  postPreventives     PostPreventive[]
  chamados            Record[]
  rps                 Rp[]
  techCards           TechCard[]
  ownSubassemblies    Subassembly[]
  hiddenSubassemblies MachineHiddenSubassembly[]

  @@index([lineId])
  @@index([equipmentId])
}

// Subconjunto do modelo que esta máquina não tem.
model MachineHiddenSubassembly {
  machineId     String
  machine       Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  subassemblyId String
  subassembly   Subassembly @relation(fields: [subassemblyId], references: [id], onDelete: Cascade)

  @@id([machineId, subassemblyId])
  @@index([subassemblyId])
}

// Subconjunto de um modelo de equipamento (Válvulas roletes da Encartuchadeira CAM). Sem máquina vale para
// todas as máquinas do modelo; com machineId, só naquela máquina.
// Arquivado sai das listas de escolha, mas o que já aponta para ele fica.
// O nome é único entre os que aparecem juntos numa máquina; a regra fica na aplicação (scopesOverlap).
model Subassembly {
  id              String                     @id @default(cuid())
  equipmentId     String
  equipment       MatrixEquipment            @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  // Subconjunto só desta máquina: sai junto com ela.
  machineId       String?
  machine         Machine?                   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name            String
  position        Int
  archived        Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  postPreventives PostPreventive[]
  records         Record[]
  rps             Rp[]
  techCards       TechCard[]
  hiddenIn        MachineHiddenSubassembly[]

  @@index([equipmentId])
  @@index([machineId])
}

model MemberRole {
  id             String   @id @default(cuid())
  name           String   @unique
  // Categoria da matriz que quem tem esta função vê (mechanical ou electrical); vazio vê as duas.
  matrixCategory String?
  // Quem tem esta função lidera equipe (o antigo cargo Supervisor): Member.position segue esta marca.
  leadsTeams     Boolean  @default(false)
  members        Member[]
}

model MemberGrade {
  id                   String   @id @default(cuid())
  name                 String   @unique
  position             Int
  // Esperado na matriz por dificuldade da habilidade para quem tem este grau (1 a 4); vazio usa o padrão da dificuldade.
  expectedBasic        Int?
  expectedIntermediate Int?
  expectedAdvanced     Int?
  members              Member[]
}

model Team {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  supervisorId String?
  supervisor   Member?  @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  members      Member[] @relation("TeamMembers")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supervisorId])
}

model Member {
  id           String       @id @default(cuid())
  name         String
  position     String       @default("technician")
  teamId       String?
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)
  roleId       String?
  role         MemberRole?  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  gradeId      String?
  grade        MemberGrade? @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  shift        String
  area         String?
  status       String
  registration String?
  contact      String?
  notes        String?
  // Aparece na lista de técnicos do formulário da página pública de RPs.
  publicRp     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  matrixEquipments    MemberMatrixEquipment[]
  skills              MemberSkill[]
  records             Record[]
  recordLinks         RecordMember[]
  rpLinks             RpMember[]
  postPreventiveLinks PostPreventiveMember[]
  supervisedTeams     Team[]                  @relation("TeamSupervisor")
  rpSupervisorLinks   RpSupervisorLink[]
  behavior            MemberBehavior?
  evaluations         MemberEvaluation[]
  lines               MemberLine[]
  pdiAttachments      MemberAttachment[]
  pdiItems            MemberPdiItem[]         @relation("PdiItemMember")
  pdiResponsible      MemberPdiItem[]         @relation("PdiItemResponsible")

  @@index([roleId])
  @@index([gradeId])
  @@index([teamId])
}

model MemberBehavior {
  memberId      String   @id
  punctuality   String?
  productivity  String?
  collaboration String?
  tags          String[]
  updatedAt     DateTime @updatedAt
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// Opções do comportamento (pontos positivos, de atenção, situação atual): cadastro do coordenador.
// MemberBehavior.tags guarda os ids. Arquivada sai das opções da ficha, mas fica em quem já tinha.
model BehaviorTag {
  id       String  @id @default(cuid())
  group    String
  name     String
  position Int
  archived Boolean @default(false)

  @@unique([group, name])
}

// Competências da avaliação de desempenho: cadastro do coordenador. Arquivada sai da avaliação, mas a nota antiga fica.
model PerformanceCompetency {
  id          String             @id @default(cuid())
  name        String             @unique
  position    Int
  archived    Boolean            @default(false)
  evaluations MemberEvaluation[]
  pdiItems    MemberPdiItem[]
}

model MemberEvaluation {
  memberId     String
  year         Int
  quarter      Int
  competencyId String
  score        Int
  updatedAt    DateTime              @updatedAt
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  competency   PerformanceCompetency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@id([memberId, year, quarter, competencyId])
  @@index([competencyId])
}

// Linhas do PDI: "sponsor" (padrinho, responsável) ou "development" (aprendendo).
model MemberLine {
  memberId String
  lineId   String
  kind     String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  line     Line   @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@id([memberId, lineId, kind])
  @@index([lineId])
}

// Arquivos do PDI. Restrict: excluir o colaborador apagaria a linha e deixaria o arquivo no disco.
model MemberAttachment {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([memberId])
}

// Itens do PDI formal: ação para fechar uma lacuna (habilidade da matriz, competência da avaliação e/ou linha), com prazo, responsável e status.
// Habilidade, competência, linha e responsável são opcionais e viram nulos se forem excluídos.
model MemberPdiItem {
  id            String                 @id @default(cuid())
  memberId      String
  member        Member                 @relation("PdiItemMember", fields: [memberId], references: [id], onDelete: Cascade)
  title         String
  skillId       String?
  skill         MatrixSkill?           @relation(fields: [skillId], references: [id], onDelete: SetNull)
  competencyId  String?
  competency    PerformanceCompetency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  lineId        String?
  line          Line?                  @relation(fields: [lineId], references: [id], onDelete: SetNull)
  responsibleId String?
  responsible   Member?                @relation("PdiItemResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  dueDate       DateTime?              @db.Date
  status        String                 @default("planned")
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([memberId])
  @@index([skillId])
  @@index([competencyId])
  @@index([lineId])
  @@index([responsibleId])
}

// Ajustes de matriz e desempenho (uma linha só, id "default"): aderência mínima para contar como qualificado e meta das notas do gráfico de desempenho.
model MatrixSetting {
  id                 String @id @default("default")
  qualifiedAdherence Int    @default(80)
  performanceTarget  Int    @default(8)
}

// Como o gestor deixou a Matriz da equipe: visão, agrupamentos e a ordem das colunas que ele arrastou.
// Uma linha só ("default"), como MatrixSetting. A ordem guarda ids de linha, máquina e modelo; id que sumiu é ignorado na tela.
model TeamMatrixLayout {
  id          String   @id @default("default")
  view        String   @default("training")
  rowGroup    String   @default("shift")
  columnGroup String   @default("line")
  columnOrder String[] @default([])
  updatedAt   DateTime @updatedAt
}

// Catálogo da matriz de habilidades: cadastro do coordenador (os 9 equipamentos e as 222 habilidades do SIGEM de partida).
// Arquivado sai da matriz, mas o que já foi marcado ou avaliado fica guardado.
model MatrixEquipment {
  id            String                  @id @default(cuid())
  name          String                  @unique
  position      Int
  archived      Boolean                 @default(false)
  // Quantos técnicos qualificados o equipamento precisa ter; 0 = sem mínimo.
  minQualified  Int                     @default(0)
  skills        MatrixSkill[]
  members       MemberMatrixEquipment[]
  machines      Machine[]
  subassemblies Subassembly[]
  techDocuments TechDocument[]
  techCards     TechCard[]
}

model MatrixSkill {
  id          String               @id @default(cuid())
  equipmentId String
  equipment   MatrixEquipment      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  subgroup    String
  text        String
  level       String
  // mechanical ou electrical: separa a matriz de mecânico da de eletricista.
  category    String               @default("mechanical")
  position    Int
  archived    Boolean              @default(false)
  scores      MemberSkill[]
  pdiItems    MemberPdiItem[]

  @@index([equipmentId])
}

model MemberMatrixEquipment {
  memberId    String
  equipmentId String
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  equipment   MatrixEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([memberId, equipmentId])
  @@index([equipmentId])
}

model MemberSkill {
  memberId      String
  skillId       String
  score         Int?
  notApplicable Boolean     @default(false)
  expected      Int?
  updatedAt     DateTime    @updatedAt
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill         MatrixSkill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([memberId, skillId])
  @@index([skillId])
}

model Record {
  id            String             @id @default(cuid())
  type          String
  body          String
  occurredAt    DateTime
  status        String
  memberId      String?
  member        Member?            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  factoryId     String?
  lineId        String?
  lineLabel     String?
  tag           String?
  line          String?
  priority      String?
  tone          String?
  dueAt         DateTime?
  // O prazo tem horário escolhido. Falso: vale só o dia (dueAt ao meio-dia de Brasília). Os prazos de antes
  // de 2026-10-15 ficam falsos: até ali a tela só escolhia o dia.
  dueHasTime    Boolean            @default(false)
  notes         String?
  origin        String
  dayNumber     Int?
  openedAt      DateTime?
  closedAt      DateTime?
  durationMin   Int?
  // Chamado: turno (first, second, third) e máquina da linha, se souber.
  shift         String?
  machineId     String?
  machine       Machine?           @relation(fields: [machineId], references: [id], onDelete: SetNull)
  // Problema: subconjunto do modelo da máquina, se souber.
  subassemblyId String?
  subassembly   Subassembly?       @relation(fields: [subassemblyId], references: [id], onDelete: SetNull)
  // Tarefa gerada a partir de um chamado ("gerar pendência").
  chamadoId     String?
  chamado       Record?            @relation("ChamadoTasks", fields: [chamadoId], references: [id], onDelete: SetNull)
  tasks         Record[]           @relation("ChamadoTasks")
  members       RecordMember[]
  attachments   RecordAttachment[]
  rp            Rp?                @relation("RpMirror")
  // RP escrito a partir deste chamado.
  rpOfChamado   Rp?                @relation("RpChamado")
  // Ordem no checklist de Pendências, dentro do grupo de prazo; nulo = nunca arrastado.
  boardPosition Float?
  // Quando foi concluído (tarefa, problema, feedback): alimenta "concluídas por semana" no Dashboard.
  // Reabrir apaga; concluídos antes de 2026-10-12 ganharam o updatedAt. Chamado usa closedAt.
  completedAt   DateTime?
  reminders     TaskReminder[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([type, status, dueAt])
  @@index([origin])
  @@index([memberId])
  @@index([lineId])
  @@index([occurredAt, id])
  @@index([createdAt])
  @@index([machineId])
  @@index([subassemblyId])
  @@index([chamadoId])
  @@index([completedAt])
}

model RecordMember {
  recordId String
  memberId String
  position Int
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([recordId, memberId])
  @@index([memberId])
}

model RecordAttachment {
  id         String   @id @default(cuid())
  recordId   String
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([recordId])
}

// RP (Relatório Padrão de Manutenção): ficha própria, com um Problema de origem "rp" como espelho nas listas.
model Rp {
  id                   String           @id @default(cuid())
  occurredAt           DateTime
  orderNumber          String?
  orderKey             String?
  factoryId            String
  lineId               String?
  line                 String?
  tag                  String?
  // Máquina da linha e subconjunto do modelo dela; vão também para o Problema espelho.
  machineId            String?
  machine              Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)
  subassemblyId        String?
  subassembly          Subassembly?     @relation(fields: [subassemblyId], references: [id], onDelete: SetNull)
  problem              String
  problemKey           String
  description          String?
  repeatedFailure      Boolean          @default(false)
  repeatedTimes        String?
  repeatedPeriod       String?
  causeMaterial        Boolean          @default(false)
  materialText         String?
  causeMachine         Boolean          @default(false)
  machineText          String?
  causeMethod          Boolean          @default(false)
  methodText           String?
  causeLabor           Boolean          @default(false)
  laborText            String?
  rootCause            String?
  corrective           String?
  preventive           String?
  status               String
  basicConditionImpact String?
  unmatchedTechnicians String?
  rawText              String
  problemRecordId      String?          @unique
  problemRecord        Record?          @relation("RpMirror", fields: [problemRecordId], references: [id], onDelete: SetNull)
  chamadoId            String?          @unique
  chamado              Record?          @relation("RpChamado", fields: [chamadoId], references: [id], onDelete: SetNull)
  // Origem: "paste" (colado ou escrito no app do coordenador) ou "public" (formulário da página pública).
  source               String           @default("paste")
  // Quando o coordenador conferiu um RP da página pública; editar pelo link volta para não conferido.
  checkedAt            DateTime?
  // Pedido de revisão do supervisor (página pública): some quando o técnico corrige e marca revisado.
  reviewRequest        String?
  reviewRequestedAt    DateTime?
  // Supervisor recusou o RP na página pública (com o motivo, se deu); editar pelo link volta para pendente.
  rejectedAt           DateTime?
  rejectionNote        String?
  members              RpMember[]
  postPreventives      PostPreventive[]
  revisions            RpRevision[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([occurredAt, id])
  @@index([lineId])
  @@index([status])
  @@index([orderKey])
  @@index([tag])
  @@index([machineId])
  @@index([subassemblyId])
  @@index([source])
}

// Link da página pública de RPs. Só um fica ativo: gerar outro desliga o anterior (revokedAt).
model RpPublicLink {
  id        String    @id @default(cuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

// Link pessoal de um supervisor na página pública: abre tudo que o link da equipe abre e ainda aprova,
// recusa, pede revisão e exporta. O nome vai para o histórico de cada RP que ele avaliar.
model RpSupervisorLink {
  id        String    @id @default(cuid())
  // O supervisor do cadastro (função que lidera equipe). Some (null) se o colaborador for excluído.
  memberId  String?
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // Nome no dia em que o link foi criado: fica para o histórico mesmo sem o colaborador.
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([memberId])
}

// Histórico de um RP da página pública: cada edição guarda os campos de antes, para o coordenador desfazer.
model RpRevision {
  id        String   @id @default(cuid())
  rpId      String
  rp        Rp       @relation(fields: [rpId], references: [id], onDelete: Cascade)
  // edit, review_request, restore, approve, reject
  kind      String
  // Campos do RP antes da mudança (forma de RpFields).
  before    Json
  note      String?
  // Nome do supervisor que aprovou, recusou ou pediu revisão; nulo nas edições e no que veio antes dos links de supervisor.
  actorName String?
  createdAt DateTime @default(now())

  @@index([rpId, createdAt])
}

model RpMember {
  rpId     String
  memberId String
  position Int
  rp       Rp     @relation(fields: [rpId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([rpId, memberId])
  @@index([memberId])
}

// Pós-preventiva: ocorrência que apareceu depois de uma preventiva, com a ação para não repetir
// e o ponto de atenção que vai para a folha do técnico na próxima preventiva da máquina.
model PostPreventive {
  id               String                 @id @default(cuid())
  preventiveDate   DateTime               @db.Date
  occurrenceDate   DateTime?              @db.Date
  machineId        String
  machine          Machine                @relation(fields: [machineId], references: [id], onDelete: Restrict)
  subassemblyId    String
  subassembly      Subassembly            @relation(fields: [subassemblyId], references: [id], onDelete: Restrict)
  done             String
  occurrence       String
  preventiveAction String
  attentionPoint   String
  // Desligado: o ponto sai da folha do técnico, mas a ficha continua no histórico.
  attentionActive  Boolean                @default(true)
  rpId             String?
  rp               Rp?                    @relation(fields: [rpId], references: [id], onDelete: SetNull)
  members          PostPreventiveMember[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([preventiveDate, id])
  @@index([machineId])
  @@index([subassemblyId])
  @@index([rpId])
}

model PostPreventiveMember {
  postPreventiveId String
  memberId         String
  position         Int
  postPreventive   PostPreventive @relation(fields: [postPreventiveId], references: [id], onDelete: Cascade)
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([postPreventiveId, memberId])
  @@index([memberId])
}

// ---- Documentação técnica (PR da thread "5. Documentação técnica por máquina") ----

// PDF (manual, catálogo, esquema) de um modelo de equipamento, guardado no disco de anexos.
model TechDocument {
  id          String          @id @default(cuid())
  equipmentId String
  equipment   MatrixEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  name        String
  kind        String
  fileName    String
  mimeType    String
  storageKey  String          @unique
  size        Int
  revision    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cards       TechCard[]

  @@index([equipmentId])
}

// Ficha de conhecimento: um fato curto tirado do manual (código de erro, interface, peça...), com a fonte.
// Vale para um modelo, uma máquina ou uma linha: só um dos três vem preenchido.
model TechCard {
  id            String           @id @default(cuid())
  type          String
  equipmentId   String?
  equipment     MatrixEquipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  machineId     String?
  machine       Machine?         @relation(fields: [machineId], references: [id], onDelete: Restrict)
  lineId        String?
  line          Line?            @relation(fields: [lineId], references: [id], onDelete: Restrict)
  subassemblyId String?
  subassembly   Subassembly?     @relation(fields: [subassemblyId], references: [id], onDelete: SetNull)
  code          String?
  title         String
  summary       String
  details       Json
  deviceTag     String?
  originalTerm  String?
  tags          String[]         @default([])
  documentId    String?
  document      TechDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  page          Int?
  sheet         String?
  reviewNeeded  Boolean          @default(false)
  // Tudo que a busca lê, já em minúsculas e sem acento (ver normalizeSearchText); índice trigram em cima.
  searchText    String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([equipmentId])
  @@index([machineId])
  @@index([lineId])
  @@index([documentId])
  @@index([type])
  // Trigram: a busca "contém" acha código, nº de peça e termo original em qualquer parte do texto.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "TechCard_searchText_trgm_idx")
}

// ---- Avisos no celular (thread "Sistema de notificações", 2026-10-14) ----

// Aparelho que aceitou receber avisos (Web Push). O navegador entrega o endereço do serviço de push e as duas
// chaves da inscrição; o servidor só guarda e usa para enviar. Endereço que o serviço diz não existir mais sai.
model PushDevice {
  id         String    @id @default(cuid())
  endpoint   String    @unique
  p256dh     String
  auth       String
  // Navegador e sistema do aparelho, para você reconhecer na lista.
  label      String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?
}

// Lembrete de uma tarefa (como no Todoist): "at" toca numa data e hora fixa; "before" toca um tempo antes do
// prazo (prazo só com dia: 7h do dia ou de dias antes). O relógio da API confere a cada minuto.
model TaskReminder {
  id            String    @id @default(cuid())
  recordId      String
  record        Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  kind          String
  at            DateTime?
  minutesBefore Int?
  // "Adiar 1 h" na notificação: toca de novo neste horário.
  snoozedUntil  DateTime?
  // Horário do último toque enviado. Se o prazo mudar, a hora de tocar muda e o lembrete toca de novo.
  sentFor       DateTime?
  createdAt     DateTime  @default(now())

  @@index([recordId])
}
