DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/manutencao?schema=public
SESSION_SECRET=troque-este-segredo
COOKIE_SECURE=false

# Profile local-db (não entra no up padrão). Aponte o DATABASE_URL para o serviço db:
# DATABASE_URL=postgresql://USER:PASSWORD@db:5432/manutencao?schema=public

# Senha do gestor. Vazia: fica a que está no banco (no começo, "gestor").
# Trocar aqui e reiniciar a API troca a senha e derruba as sessões abertas. O login da IA recusa a senha padrão.
GESTOR_PASSWORD=

# Servidor MCP (IA). Endereço público por onde o claude.ai chega: o domínio da Vercel, sem barra no fim.
PUBLIC_URL=
# Chave fixa opcional para o Claude Code (cabeçalho Authorization: Bearer). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

# Avisos no celular (Web Push). Gere o par uma vez com: pnpm --filter @manutencao/api exec web-push generate-vapid-keys
# Sem as duas chaves a API sobe, mas Configurações › Avisos fica desligado. Trocar o par desliga os aparelhos já inscritos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato que o serviço de push do navegador vê (https: ou mailto:). Vazio: usa o PUBLIC_URL.
VAPID_SUBJECT=

# Só na VPS (docker-compose.vps.yml). Endereço que o Caddy serve com HTTPS, sem https:// e sem barra.
# Ex.: o nome que a Hostinger dá à VPS (srv123456.hstgr.cloud) ou um subdomínio seu.
API_DOMAIN=
# Senha do Postgres da VPS. O banco não abre porta para a internet, mas use uma senha forte.
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
