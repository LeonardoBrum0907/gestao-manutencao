DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/manutencao?schema=public
SESSION_SECRET=troque-este-segredo
COOKIE_SECURE=false

# Profile local-db (não entra no up padrão). Aponte o DATABASE_URL para o serviço db:
# DATABASE_URL=postgresql://USER:PASSWORD@db:5432/manutencao?schema=public

# Senha do gestor. Vazia: fica a que está no banco (no começo, "gestor").
# Trocar aqui e reiniciar a API troca a senha e derruba as sessões abertas. O login da IA recusa a senha padrão.
GESTOR_PASSWORD=

# Servidor MCP (IA). Endereço público por onde o claude.ai chega: o domínio da Vercel, sem barra no fim.
PUBLIC_URL=
# Chave fixa opcional para o Claude Code (cabeçalho Authorization: Bearer). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=
