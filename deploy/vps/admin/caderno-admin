#!/usr/bin/env bash
# Comandos que o usuário `claude` da VPS pode rodar como root, via `sudo caderno-admin …`.
# O `claude` não está no grupo docker (quem está lá manda na máquina toda), então
# tudo que mexe nos containers passa por aqui, com uma lista fechada de comandos.
# Instalado como cópia de dono root em /usr/local/sbin: um git pull não muda o que roda como root.
set -euo pipefail

readonly DONO=leo
readonly PASTA=/home/leo/caderno-gestor
readonly SERVICOS="api db caddy"
# Clone separado da API de teste (docker-compose.teste.yml): fica no ramo que se publicar,
# sem mexer no checkout da produção, que segue na main.
readonly PASTA_TESTE=/home/leo/caderno-teste

uso() {
  cat <<'TEXTO'
Uso: sudo caderno-admin <comando>
  status                     containers, disco e memória
  logs <api|db|caddy> [N]    últimas N linhas (padrão 200, máximo 2000)
  backup                     roda deploy/vps/backup.sh
  deploy                     backup, git pull da main, rebuild da API e espera healthy;
                             se a API nova não subir, volta código e imagem para a versão anterior
  reiniciar api              reinicia só o container da API
  teste publicar [ramo]      sobe a API de teste no ramo do GitHub (padrão main)
  teste dados                apaga o banco e os anexos do teste e copia os da produção
  teste parar                desliga a API de teste (banco e anexos ficam guardados)
  teste status               containers do teste
  teste logs <api|db> [N]
TEXTO
}

falhar() {
  echo "caderno-admin: $1" >&2
  uso >&2
  exit 2
}

# Roda como o dono do repositório, que está no grupo docker e tem o .env.
como_dono() {
  (cd "$PASTA" && runuser -u "$DONO" -- "$@")
}

compose() {
  como_dono docker compose -f docker-compose.vps.yml "$@"
}

cmd_status() {
  compose ps
  echo
  df -h / | tail -1
  free -h | head -2
}

validar_logs() {
  local servicos="$1" servico="$2" linhas="$3"
  [[ " $servicos " == *" $servico "* ]] || falhar "serviço '$servico' inválido; esperado um de: $servicos"
  [[ "$linhas" =~ ^[0-9]{1,4}$ && "$linhas" -ge 1 && "$linhas" -le 2000 ]] || falhar "linhas '$linhas' inválido; esperado número de 1 a 2000"
}

cmd_logs() {
  local servico="${1:-}" linhas="${2:-200}"
  validar_logs "$SERVICOS" "$servico" "$linhas"
  compose logs --no-color --tail "$linhas" "$servico"
}

cmd_backup() {
  como_dono "$PASTA/deploy/vps/backup.sh"
}

# Espera o healthcheck de um container ficar healthy (até ~2 min).
esperar_saudavel() {
  local id="$1" nome="$2" tentativa
  for tentativa in $(seq 1 40); do
    [[ "$(docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null)" == healthy ]] && { echo "$nome healthy"; return 0; }
    sleep 3
  done
  return 1
}

# Espera o healthcheck do compose marcar a API como healthy (até ~2 min).
esperar_api() {
  esperar_saudavel "$(compose ps -q api)" API && return 0
  echo "API não ficou healthy; veja: sudo caderno-admin logs api" >&2
  return 1
}

# Nome da imagem que o compose gera para a API: <projeto>-<serviço>, com o projeto vindo do nome da pasta.
# Não usa `compose config --images api`: ele lista também as imagens das dependências (o postgres do db)
# e o `docker tag` recebia as duas linhas (primeiro deploy pelo Actions, 2026-10-17).
imagem_api() {
  echo caderno-gestor-api
}

# Marca a imagem em uso como :anterior, para o rollback ter para onde voltar.
guardar_imagem_atual() {
  local id
  id="$(compose ps -q api)"
  [[ -n "$id" ]] || return 0
  docker tag "$(docker inspect -f '{{.Image}}' "$id")" "$(imagem_api):anterior"
}

# Sobe o Caddy se o compose dele mudou e relê o Caddyfile sem derrubar conexões.
atualizar_caddy() {
  compose up -d --no-deps caddy
  compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile
}

# Volta o código e a imagem para a versão de antes e sai com erro, para o GitHub Actions ficar vermelho.
# O banco não volta: por isso as migrações só acrescentam (AGENTS.md), e a versão anterior roda no banco novo.
voltar_versao() {
  local anterior="$1"
  echo "caderno-admin: deploy falhou; voltando para $anterior" >&2
  como_dono git reset --keep "$anterior"
  atualizar_caddy || true
  if docker image inspect "$(imagem_api):anterior" >/dev/null 2>&1; then
    docker tag "$(imagem_api):anterior" "$(imagem_api):latest"
    compose up -d --no-deps --no-build --force-recreate api
    esperar_api || echo "caderno-admin: a versão anterior também não ficou healthy" >&2
  fi
  exit 1
}

cmd_deploy() {
  local ramo anterior
  ramo="$(como_dono git rev-parse --abbrev-ref HEAD)"
  [[ "$ramo" == main ]] || falhar "repositório no ramo '$ramo'; o deploy só roda na main"
  cmd_backup
  anterior="$(como_dono git rev-parse HEAD)"
  guardar_imagem_atual
  como_dono git pull --ff-only
  como_dono git log --oneline -1
  atualizar_caddy || voltar_versao "$anterior"
  # Build separado do up: se o build quebra, o container antigo nem é tocado.
  compose build api || voltar_versao "$anterior"
  compose up -d --no-deps --no-build api
  esperar_api || voltar_versao "$anterior"
  # Cada build deixa a imagem velha sem nome (~0,7 GB); a :anterior tem nome e fica para o rollback.
  docker image prune -f
}

# O compose do teste vem da main (pasta da produção) e o código, do clone de teste.
compose_teste() {
  (cd "$PASTA_TESTE" && runuser -u "$DONO" -- docker compose -p caderno-teste \
    -f "$PASTA/docker-compose.teste.yml" --project-directory "$PASTA_TESTE" \
    --env-file "$PASTA_TESTE/.env.teste" "$@")
}

como_dono_teste() {
  (cd "$PASTA_TESTE" && runuser -u "$DONO" -- "$@")
}

esperar_api_teste() {
  esperar_saudavel "$(compose_teste ps -q api)" "API de teste" && return 0
  echo "API de teste não ficou healthy; veja: sudo caderno-admin teste logs api" >&2
  return 1
}

teste_publicar() {
  local ramo="${1:-main}"
  # Começa com letra ou número: um ramo como "-x" viraria opção do git.
  [[ "$ramo" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || falhar "ramo '$ramo' inválido; esperado nome de ramo do GitHub, como main ou claude/fix-algo"
  como_dono_teste git fetch origin "$ramo"
  como_dono_teste git checkout --detach FETCH_HEAD
  como_dono_teste git log --oneline -1
  compose_teste up -d --build
  esperar_api_teste
}

# Copia o banco e os anexos da produção. A produção só é lida (pg_dump e tar).
teste_dados() {
  compose_teste up -d db
  esperar_saudavel "$(compose_teste ps -q db)" "Banco de teste"
  compose_teste stop api
  compose_teste exec -T db dropdb -U manutencao --if-exists --force manutencao
  compose_teste exec -T db createdb -U manutencao manutencao
  compose exec -T db pg_dump -U manutencao -Fc manutencao \
    | compose_teste exec -T db pg_restore -U manutencao -d manutencao --no-owner
  compose_teste up -d
  esperar_api_teste
  compose_teste exec -T api sh -c 'rm -rf /data/attachments/* /data/attachments/.[!.]*'
  compose exec -T api tar -C /data/attachments -cf - . \
    | compose_teste exec -T api tar -C /data/attachments -xf -
  echo "Dados da produção copiados para o teste"
}

teste_logs() {
  local servico="${1:-}" linhas="${2:-200}"
  validar_logs "api db" "$servico" "$linhas"
  compose_teste logs --no-color --tail "$linhas" "$servico"
}

cmd_teste() {
  local acao="${1:-}"
  shift || true
  [[ -f "$PASTA_TESTE/.env.teste" ]] || falhar "ambiente de teste não montado: falta $PASTA_TESTE/.env.teste (passos no README)"
  case "$acao" in
    publicar) teste_publicar "$@" ;;
    dados) teste_dados ;;
    parar) compose_teste stop ;;
    status) compose_teste ps ;;
    logs) teste_logs "$@" ;;
    *) falhar "teste '$acao' desconhecido; esperado publicar, dados, parar, status ou logs" ;;
  esac
}

cmd_reiniciar() {
  [[ "${1:-}" == api ]] || falhar "só 'reiniciar api' é permitido; recebido: '${1:-}'"
  compose restart api
  esperar_api
}

principal() {
  local comando="${1:-}"
  shift || true
  case "$comando" in
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    backup) cmd_backup ;;
    deploy) cmd_deploy ;;
    reiniciar) cmd_reiniciar "$@" ;;
    teste) cmd_teste "$@" ;;
    *) falhar "comando '$comando' desconhecido" ;;
  esac
}

principal "$@"
